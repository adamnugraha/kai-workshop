# Copy to lab.env and adjust. lab.env is ignored by git.

# full (3 database instances) or small (2 instances, for 4 vCPU / 16 GB VMs)
LAB_PROFILE=full

# Telegram alerts: create a bot with @BotFather, add it to a group, then put
# the bot token and the group chat id (a negative number) here. After
# editing, run: ./lab.sh alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Background traffic per site (journeys per second)
TRAFFIC_RATE=4

# Ports on 127.0.0.1 of this machine. Change them before "./lab.sh up" if
# something else already listens there (for example your own Prometheus on
# 9090). The SSH tunnel then points at these ports instead.
HTTP_PORT=80
PROM_PORT=9090

# Optional Docker Hub login to avoid anonymous pull limits
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# Behind a proxy that re-signs TLS? Point this at its CA bundle.
LAB_EXTRA_CA=
