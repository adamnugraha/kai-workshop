# Copy to lab.env and adjust. lab.env is ignored by git.

# How people reach the lab (choose before "./lab.sh up"; switching later
# means "./lab.sh down && ./lab.sh up", about 10 minutes):
#   public  https://app.<public-ip>.sslip.io and so on, from anywhere, with
#           free Let's Encrypt certificates (http:// works too). Open TCP 80
#           and 443 in the firewall. Operator tools ask for a login
#           (./lab.sh info).
#   tunnel  everything stays on 127.0.0.1; open it over an SSH tunnel. Use this
#           for a server without a public IP.
LAB_ACCESS=public

# Optional, public mode: your own wildcard DNS name instead of sslip.io
# (point *.lab.example.com at this machine), or force the public IP if the
# detected one is wrong.
LAB_DOMAIN=
LAB_PUBLIC_IP=

# HTTPS in public mode: auto (on when HTTP_PORT is 80) or off. Let's Encrypt
# checks each address over port 80, so port 80 must stay open for it. After
# changing this, run: ./lab.sh apply
LAB_HTTPS=auto
# Optional contact email for Let's Encrypt (not required)
LAB_ACME_EMAIL=

# full (3 database instances) or small (2 instances, for 4 vCPU / 16 GB VMs)
LAB_PROFILE=full

# Telegram alerts: create a bot with @BotFather, add it to a group, then put
# the bot token and the group chat id (a negative number) here. After
# editing, run: ./lab.sh alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Background traffic per site (journeys per second)
TRAFFIC_RATE=4

# Ports on this machine for the sites (HTTP_PORT; HTTPS needs it to be 80)
# and for Prometheus (always on 127.0.0.1). Change them before "./lab.sh up"
# if something else already listens there (for example your own Prometheus
# on 9090). In tunnel mode, point the SSH tunnel at HTTP_PORT.
HTTP_PORT=80
PROM_PORT=9090

# Optional Docker Hub login to avoid anonymous pull limits
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# Behind a proxy that re-signs TLS? Point this at its CA bundle.
LAB_EXTRA_CA=
